{
	"name": "obsidian-filen-sync",
	"version": "1.0.0",
	"description": "Sync your Obsidian vault with Filen using a direct folder mirror, optional auto-sync, conflict copies, and file versions.",
	"keywords": [],
	"homepage": "https://github.com/ilhamagustiawan/obsidian-filen-sync#readme",
	"bugs": {
		"url": "https://github.com/ilhamagustiawan/obsidian-filen-sync/issues"
	},
	"license": "AGPL-3.0-only",
	"author": "Ilham Agustiawan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ilhamagustiawan/obsidian-filen-sync.git"
	},
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy:test-vault": "npm run build && node scripts/deploy-test-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "node --test test/run-tests.mjs test/sync-ux.test.mjs test/coordinator-ux.test.mjs test/initial-sync.test.mjs test/transfer-progress.test.mjs test/sync-indicator.test.mjs test/activity-logs.test.mjs"
	},
	"dependencies": {
		"@filen/sdk": "0.4.2",
		"localforage": "^1.10.0"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"esbuild": "^0.28.1",
		"esbuild-plugin-polyfill-node": "^0.3.0",
		"obsidian": "^1.13.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"axios": "^0.34.0",
		"js-crypto-key-utils": "file:stubs/js-crypto-key-utils"
	},
	"engines": {
		"node": ">=20"
	}
}
